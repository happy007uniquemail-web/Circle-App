/**
 * Environment variables for the portfolio Next.js project.
 *
 * Copy this file to .env.local and fill in the values.
 * Do not commit real values to version control.
 *
 * Server-side only variables (not prefixed with NEXT_PUBLIC_) are marked with [SERVER].
 * Browser-exposed variables (prefixed with NEXT_PUBLIC_) are marked with [CLIENT].
 */

# Site URL - Canonical base URL for the site [SERVER]
NEXT_PUBLIC_SITE_URL=https://khushiadhikari.dev

# Resend API key for sending emails [SERVER]
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Destination email address for contact form submissions [SERVER]
CONTACT_TO_EMAIL=khushi@example.com

# Verified sender email address for contact form [SERVER]
CONTACT_FROM_EMAIL=onboarding@khushiadhikari.dev

# PostgreSQL connection string (Neon/Supabase) [SERVER]
DATABASE_URL=postgresql://user:password@db.example.com:5432/portfolio

# Upstash Redis URL for rate limiting [SERVER]
UPSTASH_REDIS_REST_URL=https://your-account.upstash.io

# Upstash Redis token for rate limiting [SERVER]
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Cloudflare Turnstile site key - exposed to client [CLIENT]
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key

# Cloudflare Turnstile secret key - server side only [SERVER]
TURNSTILE_SECRET_KEY=your-secret-key