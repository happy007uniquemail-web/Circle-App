# Circle — environment variables (required)
# Copy to .env for local dev, or set these in Netlify:
#   Site configuration → Environment variables
# The app runs in official Supabase mode only. Without both values the
# entry point renders a setup screen; there is no demo fallback.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>
